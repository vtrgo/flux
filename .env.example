# =============================================================================
# vtrFlux MES - Environment Configuration
# =============================================================================

# Server Port (default: 8080)
PORT=8080

# PostgreSQL Connection String
DATABASE_URL="host=/var/run/postgresql dbname=flux sslmode=disable"

# JWT Secret Key for Session Authentication
# Generate a secure random string for production environments
JWT_SECRET="replace-with-a-secure-random-secret-key"

# -----------------------------------------------------------------------------
# On-Premises Windows Active Directory / LDAP Integration (Future Proofing)
# -----------------------------------------------------------------------------
# Active Directory / LDAP authentication is parked until local domain controller
# and service account connectivity is provisioned.
# When enabled in the future, set LDAP_ENABLED=true and configure your DC.
LDAP_ENABLED=false
LDAP_HOST="ldaps://dc01.company.local:636"
LDAP_BASE_DN="DC=company,DC=local"
LDAP_BIND_DN="CN=FluxService,OU=ServiceAccounts,DC=company,DC=local"
LDAP_BIND_PASSWORD=""
LDAP_USER_SEARCH_FILTER="(&(objectClass=user)(sAMAccountName=%s))"
LDAP_INSECURE_SKIP_VERIFY=false

# -----------------------------------------------------------------------------
# Notification System & Microsoft Power Automate Integration
# -----------------------------------------------------------------------------
# Enable or disable outbound notifications across all channels (default: true)
NOTIFICATIONS_ENABLED=true

# Microsoft Power Automate HTTP trigger webhook URL for sending Adaptive Cards
POWER_AUTOMATE_WEBHOOK_URL="https://<environment-id>.powerplatform.com/powerautomate/automations/direct/..."

# Fallback email recipient for notifications when assignee email is unassigned
DEFAULT_NOTIFICATION_RECIPIENT_EMAIL="justin@vtrfeedersolutions.com"
